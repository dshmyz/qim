{
    "swagger": "2.0",
    "info": {
        "description": "QIM 智能办公平台后端 API 文档",
        "title": "QIM Server API",
        "contact": {
            "name": "QIM Team"
        },
        "version": "2.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/api/ai/summary/stream": {
            "post": {
                "description": "根据对话记录流式生成会话摘要，使用 SSE 返回",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "流式生成会话摘要",
                "parameters": [
                    {
                        "description": "摘要请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.GenerateSummaryRequest"
                        }
                    }
                ],
                "responses": {}
            }
        },
        "/api/v1/admin/ai/dashboard": {
            "get": {
                "description": "获取AI运维面板的统计数据",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "运维面板数据",
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/ai/router": {
            "get": {
                "description": "返回当前生效路由（DB 覆盖优先，否则 config.yaml 默认）；同时返回已配置供应商作为 provider 下拉候选",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "获取 AI 模型路由",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            },
            "put": {
                "description": "将任务→provider/model 路由写入 SystemConfig 并热更新 AIService，无需重启",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "保存 AI 模型路由",
                "parameters": [
                    {
                        "description": "路由配置 {defaultTask, routes}",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            },
            "delete": {
                "description": "删除 DB 路由覆盖并热更新回 config.yaml 配置，无需重启",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "恢复 config.yaml 默认路由",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/knowledge-graph": {
            "get": {
                "description": "获取指定集合的知识图谱节点和关系数据",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "知识图谱"
                ],
                "summary": "获取知识图谱数据",
                "parameters": [
                    {
                        "type": "string",
                        "description": "集合名称",
                        "name": "collection",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "搜索查询",
                        "name": "query",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "最大节点数",
                        "name": "max_nodes",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/tool-registry/tools": {
            "get": {
                "description": "列出所有 AI 工具及其启用状态，用于管理后台配置",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI工具管理"
                ],
                "summary": "列出所有 AI 工具（管理后台）",
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/tool-registry/tools/{tool_name}": {
            "put": {
                "description": "启用或禁用指定的 AI 工具",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI工具管理"
                ],
                "summary": "更新 AI 工具配置",
                "parameters": [
                    {
                        "type": "string",
                        "description": "工具名称",
                        "name": "tool_name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "工具配置请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.ToolRegistryConfigRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "404": {
                        "description": "工具不存在",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ai/completion": {
            "post": {
                "description": "根据消息获取AI完成",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "获取AI完成",
                "parameters": [
                    {
                        "description": "AI完成请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.GetCompletionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ai/completion/stream": {
            "post": {
                "description": "流式获取AI完成，使用服务器发送事件(SSE)返回统一JSON格式",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "流式获取AI完成",
                "parameters": [
                    {
                        "description": "AI完成请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.GetCompletionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "流式输出",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ai/describe-image": {
            "post": {
                "description": "视觉模型识别/描述图片内容，支持自定义识别指令",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "图片识别/描述",
                "parameters": [
                    {
                        "description": "图片识别请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.DescribeImageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "400": {
                        "description": "参数错误或未配置视觉路由",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ai/draft-reply": {
            "post": {
                "description": "根据目标消息及上下文生成回复草稿。⚠️ 已过时：前端已统一改走流式",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "帮我回复（已过时，将移除）",
                "parameters": [
                    {
                        "description": "起草请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.DraftReplyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ai/draft-reply/stream": {
            "post": {
                "description": "根据目标消息及上下文流式生成回复草稿，使用 SSE 返回",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "流式帮我回复",
                "parameters": [
                    {
                        "description": "起草请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.DraftReplyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "流式输出",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/ai/sidebar/stream": {
            "post": {
                "description": "在任意会话旁边随时问 AI，不改变对话本身的社交动态。\nscope=current: 注入当前会话最近消息作为上下文；\nscope=cross: 跨会话检索用户全部消息/笔记/知识库后综合回答。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "侧边栏 AI 元对话",
                "parameters": [
                    {
                        "description": "侧边栏请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.SidebarStreamRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "流式输出",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/ai/tools": {
            "get": {
                "description": "列出所有可用的 AI 工具",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "列出所有 AI 工具",
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ai/translate": {
            "post": {
                "description": "将文本翻译为目标语言",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "翻译文本",
                "parameters": [
                    {
                        "description": "翻译请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.TranslateTextRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ai/translate/image": {
            "post": {
                "description": "上传图片地址，视觉模型识别图中文字并翻译为目标语言",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "图片翻译",
                "parameters": [
                    {
                        "description": "图片翻译请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.TranslateImageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功响应",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "400": {
                        "description": "参数错误或图片无可翻译文字",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/handler.AIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/cli/download": {
            "get": {
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "CLI"
                ],
                "summary": "CLI 二进制下载",
                "parameters": [
                    {
                        "type": "string",
                        "description": "目标操作系统（默认按请求检测）",
                        "name": "os",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "目标架构（默认按请求检测）",
                        "name": "arch",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/cli/version": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "CLI"
                ],
                "summary": "CLI 版本查询",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/api/v1/notes/{id}/access": {
            "patch": {
                "description": "打开后笔记向量化进分身知识库集合，关闭后移除该笔记向量",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "笔记"
                ],
                "summary": "切换笔记「允许分身读取」状态",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "笔记ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "可见性开关",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "ai_accessible": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "更新后的笔记",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    },
                    "404": {
                        "description": "笔记不存在",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "schema": {
                            "$ref": "#/definitions/response.Response"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "ai.Message": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                },
                "tool_call_id": {
                    "type": "string"
                },
                "tool_calls": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ai.ToolCall"
                    }
                }
            }
        },
        "ai.ToolCall": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "handler.AIResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "message": {
                    "type": "string"
                }
            }
        },
        "handler.DescribeImageRequest": {
            "type": "object",
            "required": [
                "image_url"
            ],
            "properties": {
                "image_url": {
                    "type": "string"
                },
                "instruction": {
                    "description": "可选：自定义识别指令，默认\"识别图片内容并详细描述\"",
                    "type": "string"
                }
            }
        },
        "handler.DraftReplyRequest": {
            "type": "object",
            "required": [
                "conversation_id",
                "message_id"
            ],
            "properties": {
                "conversation_id": {
                    "type": "integer"
                },
                "message_id": {
                    "type": "integer"
                }
            }
        },
        "handler.GenerateSummaryRequest": {
            "type": "object",
            "required": [
                "conversation_id"
            ],
            "properties": {
                "conversation_id": {
                    "type": "integer"
                },
                "end_time": {
                    "type": "string"
                },
                "start_time": {
                    "type": "string"
                },
                "time_range": {
                    "description": "\"1h\", \"today\", \"7d\", \"custom\"",
                    "type": "string"
                }
            }
        },
        "handler.GetCompletionRequest": {
            "type": "object",
            "required": [
                "messages"
            ],
            "properties": {
                "messages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ai.Message"
                    }
                }
            }
        },
        "handler.SidebarStreamRequest": {
            "type": "object",
            "required": [
                "message"
            ],
            "properties": {
                "conversation_id": {
                    "description": "可选：当前会话 ID，传入则注入该会话上下文",
                    "type": "integer"
                },
                "message": {
                    "description": "用户问题",
                    "type": "string"
                },
                "scope": {
                    "description": "\"current\"(默认) 或 \"cross\"(跨会话检索)",
                    "type": "string"
                }
            }
        },
        "handler.ToolRegistryConfigRequest": {
            "type": "object",
            "required": [
                "enabled"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "handler.TranslateImageRequest": {
            "type": "object",
            "required": [
                "image_url"
            ],
            "properties": {
                "image_url": {
                    "type": "string"
                },
                "target_lang": {
                    "description": "默认 zh",
                    "type": "string"
                }
            }
        },
        "handler.TranslateTextRequest": {
            "type": "object",
            "required": [
                "target_lang",
                "text"
            ],
            "properties": {
                "source_lang": {
                    "description": "auto/zh/en/...",
                    "type": "string"
                },
                "target_lang": {
                    "description": "zh/en/ja/ko/fr/de",
                    "type": "string"
                },
                "text": {
                    "type": "string"
                }
            }
        },
        "response.Response": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "message": {
                    "type": "string"
                }
            }
        }
    },
